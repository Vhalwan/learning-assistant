GEMINI_API_KEY=your_gemini_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Public URL for the deployed Streamlit app.
LECTOVA_APP_URL=https://your-lectova-app.example.com

# Optional GitHub Pages bridge page for Supabase password recovery links.
PASSWORD_RESET_BRIDGE_URL=https://your-github-user.github.io/learning-assistant/reset-password.html

# Optional full redirect override. If set, this wins over PASSWORD_RESET_BRIDGE_URL.
# PASSWORD_RESET_REDIRECT_URL=https://your-github-user.github.io/learning-assistant/reset-password.html?next=https%3A%2F%2Fyour-lectova-app.example.com%2F
